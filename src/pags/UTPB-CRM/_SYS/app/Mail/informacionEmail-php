<?php

namespace App\Mail;

use Illuminate\Bus\Queueable;
use Illuminate\Contracts\Queue\ShouldQueue;
use Illuminate\Mail\Mailable;
use Illuminate\Queue\SerializesModels;

class informacionEmail extends Mailable
{
    use Queueable, SerializesModels;

    /**
     * Create a new message instance.
     *
     * @return void
     */
    public function __construct($data,$files,$names,$subject, $user)
    {
        $this->data = $data;
        $this->files = $files;
        $this->names = $names;
        $this->subject = $subject;
        $this->_email = $user->email;
        $this->_name = $user->name;
    }

    /**
     * Build the message.
     *
     * @return $this
     */
    public function build()
    {
      foreach ($this->files as $key => $file) {
        $this->attach($file,["as"=>$this->names[$key]]);
      }
      return $this->from(ENV("MAIL_ALIAS"), $this->subject ?? ENV("MAIL_SUBJECT"))
              ->subject("Aquí esta la información solicitada ".\Carbon\carbon::now())
              ->replyto([auth()->user()->name ?? $this->_name => auth()->user()->email ?? $this->_email])
              ->view('correos.data')->with(["data"=>$this->data]);
    }
}
